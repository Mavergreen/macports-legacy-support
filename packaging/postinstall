#!/bin/sh
# Load the daily update-check agent, then borrow the system's own framework icon for the updater.
#
# The agent-load logic is NOT written here: stage_updater.sh renders it beside this script as
# agent-load.sh, so every Mavergreen product loads its agent the same way.
AGENT_LOAD="$(dirname "$0")/agent-load.sh"
if [ -f "$AGENT_LOAD" ]; then
    . "$AGENT_LOAD"
fi

# ONE-TIME MIGRATION off the ModernMavericks identity (flag day 2026-09-22).
# DELETABLE once no pre-flag-day install survives (see shipyard SKILL.md "Consolidation backlog").
#
# The pkg identifier moved from dev.modernmavericks.macports-legacy-support to
# dev.mavergreen.macports-legacy-support, and to Installer a different identifier is a different
# package: the old receipt would stay behind claiming the dylibs this pkg now owns, and `pkgutil
# --pkgs` would list both forever. Forget it on Installer's target volume ($3); with none, nothing is
# known about where the old install lives, so nothing is done. Best-effort: never fail the install over
# a receipt. Everything else the old identity left is already handled: the dylibs and headers did not
# move (this payload overwrites them), and the old updater .app and its agent are retired by
# agent-load.sh above (shipyard's shared updater/agent-load.in).
if [ -n "${3:-}" ]; then
    pkgutil --volume "$3" --forget dev.modernmavericks.macports-legacy-support >/dev/null 2>&1 || true
fi

# Icon: we ship a neutral placeholder and swap in Mac OS X's own framework icon at install time --
# the same rule the rest of the line follows, so no Apple artwork travels in our payload. A machine
# missing every candidate just keeps the placeholder; that is why this is best-effort. The updater is
# the one on Installer's target volume ($3), which is "/" for the boot volume.
UPD_ICON="${3%/}/Library/Application Support/Mavergreen/LegacySupportUpdater.app/Contents/Resources/macports-legacy-support-updater.icns"
CORETYPES="/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources"
if [ -f "$UPD_ICON" ]; then
    for candidate in \
        "$CORETYPES/GenericFrameworkIcon.icns" \
        "$CORETYPES/LibraryFolderIcon.icns" \
        "$CORETYPES/KEXT.icns"; do
        if [ -f "$candidate" ]; then
            cp "$candidate" "$UPD_ICON" 2>/dev/null || true
            break
        fi
    done
fi

exit 0
